+        // EE candidate equality is unordered, while distance types are
+        // directional. Canonicalize BOTH before hashing/merging; otherwise
+        // reversed mollified EV stencils can merge unrelated distances and
+        // make the potential depend on TBB's thread partitioning.
+        EdgeEdgeNormalCollision collision(
+            edge0_id, edge1_id, eps_x, weight, weight_gradient, dtype);
+        if (collision.edge0_id > collision.edge1_id) {
+            std::swap(collision.edge0_id, collision.edge1_id);
+            switch (collision.dtype) {
+            case EdgeEdgeDistanceType::EA0_EB1:
+                collision.dtype = EdgeEdgeDistanceType::EA1_EB0; break;
+            case EdgeEdgeDistanceType::EA1_EB0:
+                collision.dtype = EdgeEdgeDistanceType::EA0_EB1; break;
+            case EdgeEdgeDistanceType::EA_EB0:
+                collision.dtype = EdgeEdgeDistanceType::EA0_EB; break;
+            case EdgeEdgeDistanceType::EA0_EB:
+                collision.dtype = EdgeEdgeDistanceType::EA_EB0; break;
+            case EdgeEdgeDistanceType::EA_EB1:
+                collision.dtype = EdgeEdgeDistanceType::EA1_EB; break;
+            case EdgeEdgeDistanceType::EA1_EB:
+                collision.dtype = EdgeEdgeDistanceType::EA_EB1; break;
+            default: break; // endpoint 00/11, interior-interior, AUTO
+            }
